{
  "selection_rule": "Common C/POSIX headers available on Linux amd64 and macOS arm64, plus the widely used sys/file.h/flock extension",
  "posix_reference": "https://pubs.opengroup.org/onlinepubs/9699919799/basedefs/contents.html",
  "headers": [
    "arpa/inet.h",
    "assert.h",
    "ctype.h",
    "dirent.h",
    "dlfcn.h",
    "errno.h",
    "fcntl.h",
    "fnmatch.h",
    "glob.h",
    "grp.h",
    "inttypes.h",
    "libgen.h",
    "limits.h",
    "locale.h",
    "net/if.h",
    "netdb.h",
    "netinet/in.h",
    "poll.h",
    "pthread.h",
    "pwd.h",
    "sched.h",
    "semaphore.h",
    "setjmp.h",
    "signal.h",
    "spawn.h",
    "stdbool.h",
    "stddef.h",
    "stdint.h",
    "stdio.h",
    "stdlib.h",
    "string.h",
    "strings.h",
    "sys/file.h",
    "sys/mman.h",
    "sys/resource.h",
    "sys/select.h",
    "sys/socket.h",
    "sys/stat.h",
    "sys/statvfs.h",
    "sys/time.h",
    "sys/times.h",
    "sys/types.h",
    "sys/uio.h",
    "sys/un.h",
    "sys/utsname.h",
    "sys/wait.h",
    "termios.h",
    "time.h",
    "unistd.h",
    "utime.h"
  ],
  "header_count": 50,
  "additional_common_extensions": [
    "sys/file.h"
  ],
  "strict_POSIX_feature_macros": false,
  "platforms": [
    "linux/amd64 (Bootlin glibc 2.44)",
    "darwin/arm64 (macOS 14.0 SDK)"
  ],
  "excluded_entry_point_examples": [
    "gnu/libc-version.h",
    "mach/*",
    "scsi/*",
    "arpa/telnet.h",
    "sys/epoll.h",
    "sys/event.h"
  ]
}
